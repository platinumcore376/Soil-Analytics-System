{
  "name": "soil-health-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Farmer-facing mobile-first PWA for the AI-Based Soil Health Assessment System",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-locales.mjs && next build --webpack",
    "start": "next start",
    "lint": "npm run typecheck",
    "typecheck": "node scripts/check-locales.mjs && tsc --noEmit",
    "check-locales": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "i18next": "^26.3.6",
    "next": "^16.3.0",
    "next-i18next": "^16.0.10",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
