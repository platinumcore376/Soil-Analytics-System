# Copy to .env and fill in DB_PASSWORD. PostgreSQL is required - no SQLite fallback.
# Create the database first:  createdb soil_health

# --- Database (PostgreSQL, required) ---
# Split into components so the password is its own variable: easier to rotate, and it
# can come from a secret manager without rewriting a whole URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soil_health
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DRIVER=postgresql+psycopg2

# Optional full-URL override. When set it wins over the DB_* values above.
# DATABASE_URL=postgresql+psycopg2://postgres:data@localhost:5432/soil_health

# --- Storage ---
# Local disk for now. Swap to S3/GCS in Phase 3.
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

# --- Image validation ---
MAX_UPLOAD_MB=10
TARGET_IMAGE_SIZE=1024

# --- App ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth (required) ---
# Signing key for access tokens. No default: the app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_real_secret_at_least_32_chars_long
JWT_EXPIRE_MINUTES=10080


