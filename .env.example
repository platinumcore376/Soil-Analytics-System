# Copy to .env and adjust. PostgreSQL is required — there is no SQLite fallback.

# --- Database (PostgreSQL, required) ---
# Create the database first:  createdb soil_health
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/soil_health

# --- Storage ---
# Local disk for now. Swap to S3/GCS in Phase 3.
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

# --- Image validation ---
MAX_UPLOAD_MB=10
TARGET_IMAGE_SIZE=1024

# --- App ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
